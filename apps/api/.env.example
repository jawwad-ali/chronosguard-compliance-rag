# ChronosGuard API — environment contract.
# Copy to .env for local dev. In prod these come from the PaaS (Render env groups).
# .env is git-ignored; never commit secrets.

ENV=local
LOG_LEVEL=INFO

# Request path — least-privilege app role (RLS-bound). Created by migration 0001.
DATABASE_URL=postgresql+asyncpg://cg_app:cg_app_dev_password@localhost:5432/chronosguard

# Worker/CLI path — corpus writes + per-job tenant context.
DATABASE_URL_WORKER=postgresql+asyncpg://cg_worker:cg_worker_dev_password@localhost:5432/chronosguard

# Migrations only — owner role (matches infra/docker-compose.yml locally).
DATABASE_URL_OWNER=postgresql+asyncpg://cg_owner:cg_owner_dev_password@localhost:5432/chronosguard

# JSON list — explicit allowlist, never a wildcard.
CORS_ORIGINS=["http://localhost:3000"]

# OpenAI (required from Chunk 4 onward; CI always uses fakes)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_AUDIT_MODEL=gpt-4o-mini

# Server-side pepper mixed into API-key hashes (required in prod from Chunk 2)
API_KEY_PEPPER=local_dev_pepper
